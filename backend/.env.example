# =============================================================
# SEYVEN Backend Environment Variables Template (.env.example)
# Copy this file to .env and fill in your environment secrets.
# NEVER commit your actual .env file to Git!
# =============================================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Database (PostgreSQL 16+)
DATABASE_URL=postgresql://db_user:db_password@localhost:5432/seyven_db?schema=public
DIRECT_URL=postgresql://db_user:db_password@localhost:5432/seyven_db?schema=public

# Redis 7 Cache & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Application Tokens
SEYVEN_JWT_ACCESS_TOKEN_SECRET=your_jwt_access_secret_here
SEYVEN_JWT_ACCESS_EXPIRATION=15m
SEYVEN_JWT_REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_here
SEYVEN_JWT_REFRESH_EXPIRATION=7d
SEYVEN_PREVIEW_TOKEN_SECRET=your_preview_token_secret_here

# Sentry & Observability
SENTRY_DSN=
LOG_LEVEL=debug

# Resend Email Configuration
RESEND_API_KEY=
RESEND_EMAIL=

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Telegram Order Alert Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pathao Courier Logistics API
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_MERCHANT_ID=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_WEBHOOK_SECRET=

# Steadfast Courier Logistics API
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_WEBHOOK_SECRET=

# Meta Conversions API (CAPI) & Pixel
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

