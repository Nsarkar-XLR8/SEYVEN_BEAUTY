# SEYVEN Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://seyven_user:seyven_secret_pass@localhost:5432/seyven_db?schema=public

# Redis 7 Cache & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO / Local S3 Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=seyven_minio_admin
MINIO_SECRET_KEY=seyven_minio_secret_key
MINIO_BUCKET_NAME=seyven-media

# Security & Tokens
JWT_ACCESS_SECRET=seyven_ultra_secure_jwt_access_secret_key_2026
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=seyven_ultra_secure_jwt_refresh_secret_key_2026
JWT_REFRESH_EXPIRATION=7d
PREVIEW_TOKEN_SECRET=seyven_preview_token_secret_2026

# Sentry & Observability
SENTRY_DSN=
LOG_LEVEL=debug

# Telegram Order Alert Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
