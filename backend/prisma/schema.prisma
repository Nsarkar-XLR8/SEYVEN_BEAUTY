generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TransactionalOutbox {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String       @map("aggregate_type") @db.VarChar(100)
  aggregateId   String       @map("aggregate_id") @db.VarChar(100)
  eventType     String       @map("event_type") @db.VarChar(100)
  payload       Json
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0) @map("retry_count")
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(6)

  @@index([status, createdAt], map: "idx_outbox_pending")
  @@map("transactional_outbox")
}

model User {
  id                                                               String                    @id @default(uuid()) @db.Uuid
  phone                                                            String                    @unique @db.VarChar(20)
  email                                                            String?                   @unique @db.VarChar(255)
  fullName                                                         String?                   @map("full_name") @db.VarChar(150)
  passwordHash                                                     String?                   @map("password_hash") @db.VarChar(255)
  role                                                             UserRole                  @default(CUSTOMER)
  isPhoneVerified                                                  Boolean                   @default(false) @map("is_phone_verified")
  fraudRiskScore                                                   Int                       @default(0) @map("fraud_risk_score")
  isBlacklisted                                                    Boolean                   @default(false) @map("is_blacklisted")
  createdAt                                                        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                                        DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  batchRecalls                                                     BatchRecall[]
  claims_registry                                                  claims_registry[]
  couponUsages                                                     CouponUsage[]
  customer_dermal_profiles                                         customer_dermal_profiles?
  customer_grievances_customer_grievances_assigned_agent_idTousers customer_grievances[]     @relation("customer_grievances_assigned_agent_idTousers")
  customer_grievances_customer_grievances_user_idTousers           customer_grievances[]     @relation("customer_grievances_user_idTousers")
  inventoryAudits                                                  InventoryAuditLog[]
  loyaltyAccount                                                   LoyaltyAccount?
  orderAuditLogs                                                   OrderAuditLog[]
  orderCallVerifications                                           OrderCallVerification[]
  orders                                                           Order[]
  product_reviews                                                  product_reviews[]
  inspectedRmas                                                    RmaRequest[]              @relation("RmaInspector")
  rmaRequests                                                      RmaRequest[]
  rtoExpenses                                                      RtoExpense[]
  addresses                                                        UserAddress[]
  user_consent_logs                                                user_consent_logs[]

  @@map("users")
}

model UserAddress {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  division      String   @db.VarChar(50)
  district      String   @db.VarChar(50)
  thanaArea     String   @map("thana_area") @db.VarChar(100)
  courierZoneId Int      @map("courier_zone_id")
  streetAddress String   @map("street_address")
  landmark      String?
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_addresses")
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  slug        String     @unique @db.VarChar(100)
  nameEn      String     @map("name_en") @db.VarChar(150)
  nameBn      String     @map("name_bn") @db.VarChar(150)
  description String?
  parentId    String?    @map("parent_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@map("categories")
}

model Product {
  id                  String                @id @default(uuid()) @db.Uuid
  categoryId          String?               @map("category_id") @db.Uuid
  slug                String                @unique @db.VarChar(255)
  titleEn             String                @map("title_en") @db.VarChar(255)
  titleBn             String                @map("title_bn") @db.VarChar(255)
  shortDescriptionEn  String?               @map("short_description_en")
  shortDescriptionBn  String?               @map("short_description_bn")
  dermalProtocolEn    String?               @map("dermal_protocol_en")
  dermalProtocolBn    String?               @map("dermal_protocol_bn")
  patchTestGuideEn    String?               @map("patch_test_guide_en")
  patchTestGuideBn    String?               @map("patch_test_guide_bn")
  isPregnancySafe     Boolean               @default(true) @map("is_pregnancy_safe")
  isLactationSafe     Boolean               @default(true) @map("is_lactation_safe")
  paoMonths           Int                   @default(12) @map("pao_months") @db.SmallInt
  storageGuidanceEn   String?               @map("storage_guidance_en")
  storageGuidanceBn   String?               @map("storage_guidance_bn")
  bstiStatus          BstiStatus            @default(PENDING) @map("bsti_status")
  bstiLicenseNumber   String?               @map("bsti_license_number") @db.VarChar(100)
  publicationState    PublicationState      @default(DRAFT) @map("publication_state")
  scheduledAt         DateTime?             @map("scheduled_at") @db.Timestamptz(6)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  claims_registry     claims_registry[]
  product_ingredients product_ingredients[]
  product_reviews     product_reviews[]
  variants            ProductVariant[]
  waitlists           ProductWaitlist[]
  category            Category?             @relation(fields: [categoryId], references: [id])

  @@map("products")
}

model ProductVariant {
  id                String            @id @default(uuid()) @db.Uuid
  productId         String            @map("product_id") @db.Uuid
  sku               String            @unique @db.VarChar(100)
  barcode           String?           @db.VarChar(50)
  volumeMlG         Decimal           @map("volume_ml_g") @db.Decimal(8, 2)
  priceBdt          Decimal           @map("price_bdt") @db.Decimal(10, 2)
  compareAtPriceBdt Decimal?          @map("compare_at_price_bdt") @db.Decimal(10, 2)
  cogsBdt           Decimal           @map("cogs_bdt") @db.Decimal(10, 2)
  weightGrams       Int               @default(250) @map("weight_grams")
  isActive          Boolean           @default(true) @map("is_active")
  isBundle          Boolean           @default(false) @map("is_bundle")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  batchRecalls      BatchRecall[]
  bundleComponents  BundleItem[]      @relation("BundleParent")
  partOfBundles     BundleItem[]      @relation("BundleComponent")
  lots              InventoryLot[]
  product_reviews   product_reviews[]
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  waitlists         ProductWaitlist[]

  @@map("product_variants")
}

model BundleItem {
  id              String         @id @default(uuid()) @db.Uuid
  bundleVariantId String         @map("bundle_variant_id") @db.Uuid
  childVariantId  String         @map("child_variant_id") @db.Uuid
  quantity        Int            @default(1)
  bundleVariant   ProductVariant @relation("BundleParent", fields: [bundleVariantId], references: [id], onDelete: Cascade)
  childVariant    ProductVariant @relation("BundleComponent", fields: [childVariantId], references: [id])

  @@unique([bundleVariantId, childVariantId])
  @@map("bundle_items")
}

model InventoryLot {
  id                String              @id @default(uuid()) @db.Uuid
  variantId         String              @map("variant_id") @db.Uuid
  batchNumber       String              @map("batch_number") @db.VarChar(100)
  manufacturingDate DateTime            @map("manufacturing_date") @db.Date
  expiryDate        DateTime            @map("expiry_date") @db.Date
  paoMonths         Int                 @default(12) @map("pao_months") @db.SmallInt
  initialQuantity   Int                 @map("initial_quantity")
  availableQuantity Int                 @map("available_quantity")
  reservedQuantity  Int                 @default(0) @map("reserved_quantity")
  status            LotStatus           @default(ACTIVE)
  minShelfLifeDays  Int                 @default(90) @map("min_shelf_life_days")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  auditLogs         InventoryAuditLog[]
  variant           ProductVariant      @relation(fields: [variantId], references: [id])

  @@map("inventory_lots")
}

model InventoryAuditLog {
  id               String       @id @default(uuid()) @db.Uuid
  lotId            String       @map("lot_id") @db.Uuid
  staffUserId      String?      @map("staff_user_id") @db.Uuid
  previousQuantity Int          @map("previous_quantity")
  newQuantity      Int          @map("new_quantity")
  adjustmentDelta  Int          @map("adjustment_delta")
  reasonCode       String       @map("reason_code") @db.VarChar(100)
  notes            String?
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  lot              InventoryLot @relation(fields: [lotId], references: [id])
  staffUser        User?        @relation(fields: [staffUserId], references: [id])

  @@map("inventory_audit_logs")
}

model BatchRecall {
  id                       String          @id @default(uuid()) @db.Uuid
  batchNumber              String          @map("batch_number") @db.VarChar(100)
  variantId                String?         @map("variant_id") @db.Uuid
  reason                   String
  initiatedBy              String?         @map("initiated_by") @db.Uuid
  totalUnitsAffected       Int             @default(0) @map("total_units_affected")
  customerAlertsDispatched Int             @default(0) @map("customer_alerts_dispatched")
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  initiator                User?           @relation(fields: [initiatedBy], references: [id])
  variant                  ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("batch_recalls")
}

model Order {
  id                  String                  @id @default(uuid()) @db.Uuid
  orderNumber         String                  @unique @map("order_number") @db.VarChar(50)
  userId              String?                 @map("user_id") @db.Uuid
  guestPhone          String                  @map("guest_phone") @db.VarChar(20)
  guestName           String                  @map("guest_name") @db.VarChar(150)
  shippingAddress     Json                    @map("shipping_address")
  subtotalBdt         Decimal                 @map("subtotal_bdt") @db.Decimal(10, 2)
  deliveryFeeBdt      Decimal                 @map("delivery_fee_bdt") @db.Decimal(10, 2)
  discountBdt         Decimal                 @default(0) @map("discount_bdt") @db.Decimal(10, 2)
  vatBdt              Decimal                 @map("vat_bdt") @db.Decimal(10, 2)
  totalPayableBdt     Decimal                 @map("total_payable_bdt") @db.Decimal(10, 2)
  advancePaidBdt      Decimal                 @default(0) @map("advance_paid_bdt") @db.Decimal(10, 2)
  codDueBdt           Decimal                 @map("cod_due_bdt") @db.Decimal(10, 2)
  status              OrderStatus             @default(PLACED)
  paymentStatus       PaymentStatus           @default(PENDING) @map("payment_status")
  courierBookingId    String?                 @map("courier_booking_id") @db.VarChar(100)
  trackingCode        String?                 @map("tracking_code") @db.VarChar(100)
  utmSource           String?                 @map("utm_source") @db.VarChar(100)
  utmMedium           String?                 @map("utm_medium") @db.VarChar(100)
  utmCampaign         String?                 @map("utm_campaign") @db.VarChar(100)
  utmTerm             String?                 @map("utm_term") @db.VarChar(100)
  utmContent          String?                 @map("utm_content") @db.VarChar(100)
  firstTouchUtm       Json?                   @map("first_touch_utm")
  lastTouchUtm        Json?                   @map("last_touch_utm")
  fbclid              String?                 @map("fbclid") @db.VarChar(150)
  gclid               String?                 @map("gclid") @db.VarChar(150)
  metaEventId         String?                 @map("meta_event_id") @db.VarChar(100)
  source              OrderSource             @default(STOREFRONT)
  staffNotes          String?                 @map("staff_notes")
  channelReference    String?                 @map("channel_reference") @db.VarChar(100)
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  loyaltyTransactions LoyaltyTransaction[]
  marketingEvents     MarketingEvent[]
  mushakCreditNotes   MushakCreditNote[]
  mushakInvoice       MushakInvoice?
  auditLogs           OrderAuditLog[]
  callVerifications   OrderCallVerification[]
  items               OrderItem[]
  user                User?                   @relation(fields: [userId], references: [id])
  paymentTransactions PaymentTransaction[]
  product_reviews     product_reviews[]
  rmaRequests         RmaRequest[]
  rtoExpenses         RtoExpense[]
  splitLedger         SplitPaymentLedger?

  @@map("orders")
}

model OrderItem {
  id           String    @id @default(uuid()) @db.Uuid
  orderId      String    @map("order_id") @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  variantId    String    @map("variant_id") @db.Uuid
  title        String    @db.VarChar(255)
  sku          String    @db.VarChar(100)
  quantity     Int
  unitPriceBdt Decimal   @map("unit_price_bdt") @db.Decimal(10, 2)
  lineTotalBdt Decimal   @map("line_total_bdt") @db.Decimal(10, 2)
  isGwp        Boolean   @default(false) @map("is_gwp")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rmaItems     RmaItem[]

  @@index([orderId], map: "idx_order_items_order")
  @@map("order_items")
}

model MushakInvoice {
  id                 String             @id @default(uuid()) @db.Uuid
  orderId            String             @unique @map("order_id") @db.Uuid
  mushakSerialNo     String             @unique @map("mushak_serial_no") @db.VarChar(100)
  sellerBin          String             @map("seller_bin") @db.VarChar(50)
  customerName       String             @map("customer_name") @db.VarChar(150)
  customerPhone      String             @map("customer_phone") @db.VarChar(50)
  itemizedBreakdown  Json               @map("itemized_breakdown")
  totalTaxableAmount Decimal            @map("total_taxable_amount") @db.Decimal(10, 2)
  totalVatAmount     Decimal            @map("total_vat_amount") @db.Decimal(10, 2)
  issuedAt           DateTime           @default(now()) @map("issued_at") @db.Timestamptz(6)
  creditNotes        MushakCreditNote[]
  order              Order              @relation(fields: [orderId], references: [id])

  @@map("mushak_invoices")
}

model MushakCreditNote {
  id                    String        @id @default(uuid()) @db.Uuid
  mushakInvoiceId       String        @map("mushak_invoice_id") @db.Uuid
  orderId               String        @map("order_id") @db.Uuid
  creditNoteSerialNo    String        @unique @map("credit_note_serial_no") @db.VarChar(100)
  reason                String        @db.VarChar(100)
  refundedTaxableAmount Decimal       @map("refunded_taxable_amount") @db.Decimal(10, 2)
  refundedVatAmount     Decimal       @map("refunded_vat_amount") @db.Decimal(10, 2)
  issuedAt              DateTime      @default(now()) @map("issued_at") @db.Timestamptz(6)
  mushakInvoice         MushakInvoice @relation(fields: [mushakInvoiceId], references: [id])
  order                 Order         @relation(fields: [orderId], references: [id])

  @@map("mushak_credit_notes")
}

model LoyaltyAccount {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @unique @map("user_id") @db.Uuid
  pointsBalance  Int                  @default(0) @map("points_balance")
  lifetimePoints Int                  @default(0) @map("lifetime_points")
  tier           String               @default("BRONZE") @db.VarChar(50)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   LoyaltyTransaction[]

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id             String                 @id @default(uuid()) @db.Uuid
  accountId      String                 @map("account_id") @db.Uuid
  orderId        String?                @map("order_id") @db.Uuid
  type           LoyaltyTransactionType
  points         Int
  runningBalance Int                    @map("running_balance")
  description    String                 @db.VarChar(255)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  account        LoyaltyAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order          Order?                 @relation(fields: [orderId], references: [id])

  @@index([accountId, createdAt], map: "idx_loyalty_trx_account_created")
  @@index([orderId], map: "idx_loyalty_trx_order")
  @@map("loyalty_transactions")
}

model SearchQueryLog {
  id              String   @id @default(uuid()) @db.Uuid
  query           String   @db.VarChar(255)
  normalizedQuery String   @map("normalized_query") @db.VarChar(255)
  totalResults    Int      @default(0) @map("total_results")
  userId          String?  @map("user_id") @db.Uuid
  ipAddress       String?  @map("ip_address") @db.VarChar(50)
  userAgent       String?  @map("user_agent")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([totalResults, createdAt], map: "idx_search_zero_results")
  @@index([normalizedQuery], map: "idx_search_query")
  @@map("search_query_logs")
}

model ProductWaitlist {
  id         String          @id @default(uuid()) @db.Uuid
  productId  String          @map("product_id") @db.Uuid
  variantId  String?         @map("variant_id") @db.Uuid
  phone      String          @db.VarChar(20)
  email      String?         @db.VarChar(255)
  userId     String?         @map("user_id") @db.Uuid
  isNotified Boolean         @default(false) @map("is_notified")
  notifiedAt DateTime?       @map("notified_at") @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([productId, isNotified], map: "idx_waitlist_product")
  @@map("product_waitlists")
}

model Coupon {
  id               String        @id @default(uuid()) @db.Uuid
  code             String        @unique @db.VarChar(50)
  titleEn          String        @map("title_en") @db.VarChar(200)
  titleBn          String        @map("title_bn") @db.VarChar(200)
  discountType     DiscountType  @default(PERCENTAGE) @map("discount_type")
  discountValue    Decimal       @map("discount_value") @db.Decimal(10, 2)
  maxDiscountBdt   Decimal?      @map("max_discount_bdt") @db.Decimal(10, 2)
  minOrderValueBdt Decimal       @default(0) @map("min_order_value_bdt") @db.Decimal(10, 2)
  isFirstOrderOnly Boolean       @default(false) @map("is_first_order_only")
  allowStacking    Boolean       @default(false) @map("allow_stacking")
  usageLimit       Int?          @map("usage_limit")
  usageCount       Int           @default(0) @map("usage_count")
  userUsageLimit   Int           @default(1) @map("user_usage_limit")
  startsAt         DateTime      @default(now()) @map("starts_at") @db.Timestamptz(6)
  expiresAt        DateTime?     @map("expires_at") @db.Timestamptz(6)
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  usages           CouponUsage[]

  @@index([code, isActive], map: "idx_coupons_code_active")
  @@map("coupons")
}

model CouponUsage {
  id                String   @id @default(uuid()) @db.Uuid
  couponId          String   @map("coupon_id") @db.Uuid
  userId            String?  @map("user_id") @db.Uuid
  orderId           String?  @map("order_id") @db.Uuid
  discountAmountBdt Decimal  @map("discount_amount_bdt") @db.Decimal(10, 2)
  usedAt            DateTime @default(now()) @map("used_at") @db.Timestamptz(6)
  coupon            Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user              User?    @relation(fields: [userId], references: [id])

  @@index([couponId, userId], map: "idx_coupon_usages_user")
  @@map("coupon_usages")
}

model Promotion {
  id            String    @id @default(uuid()) @db.Uuid
  slug          String    @unique @db.VarChar(100)
  titleEn       String    @map("title_en") @db.VarChar(200)
  titleBn       String    @map("title_bn") @db.VarChar(200)
  descriptionEn String?   @map("description_en")
  descriptionBn String?   @map("description_bn")
  bannerUrl     String?   @map("banner_url")
  promotionType String    @map("promotion_type") @db.VarChar(50)
  minSpendBdt   Decimal   @default(0) @map("min_spend_bdt") @db.Decimal(10, 2)
  rewardPayload Json      @map("reward_payload")
  isActive      Boolean   @default(true) @map("is_active")
  startsAt      DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([slug, isActive], map: "idx_promotions_slug_active")
  @@map("promotions")
}

model PaymentTransaction {
  id               String                   @id @default(uuid()) @db.Uuid
  orderId          String                   @map("order_id") @db.Uuid
  transactionId    String?                  @unique @map("transaction_id") @db.VarChar(100)
  gatewayPaymentId String?                  @unique @map("gateway_payment_id") @db.VarChar(100)
  gateway          PaymentGateway
  paymentType      PaymentType              @default(FULL_PREPAYMENT) @map("payment_type")
  amountBdt        Decimal                  @map("amount_bdt") @db.Decimal(10, 2)
  status           PaymentTransactionStatus @default(PENDING)
  idempotencyKey   String?                  @unique @map("idempotency_key") @db.VarChar(100)
  gatewayResponse  Json?                    @map("gateway_response")
  refundReason     String?                  @map("refund_reason")
  refundTrxId      String?                  @map("refund_trx_id") @db.VarChar(100)
  metadata         Json?
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  ledgerEntries    PaymentLedgerEntry[]
  order            Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "idx_payment_trx_order")
  @@index([gateway, status], map: "idx_payment_trx_gateway_status")
  @@map("payment_transactions")
}

model SplitPaymentLedger {
  id                 String               @id @default(uuid()) @db.Uuid
  orderId            String               @unique @map("order_id") @db.Uuid
  totalPayableBdt    Decimal              @map("total_payable_bdt") @db.Decimal(10, 2)
  advanceRequiredBdt Decimal              @default(0) @map("advance_required_bdt") @db.Decimal(10, 2)
  advancePaidBdt     Decimal              @default(0) @map("advance_paid_bdt") @db.Decimal(10, 2)
  codDueBdt          Decimal              @map("cod_due_bdt") @db.Decimal(10, 2)
  isFullySettled     Boolean              @default(false) @map("is_fully_settled")
  settledAt          DateTime?            @map("settled_at") @db.Timestamptz(6)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
